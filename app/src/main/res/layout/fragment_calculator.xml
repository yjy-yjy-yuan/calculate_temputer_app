<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:padding="12dp"
    tools:context=".ui.calculator.CalculatorFragment">

    <LinearLayout
        android:id="@+id/display_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/calculator_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/expression_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/calc_secondary"
            android:textSize="16sp"
            tools:text="12 + 7 ×" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/calculator_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/CalculatorButton.Light"
            android:text="C" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_divide"
            style="@style/CalculatorButton.Light"
            android:text="÷" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_multiply"
            style="@style/CalculatorButton.Light"
            android:text="×" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/CalculatorButton.Light"
            android:text="DEL" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_7"
            style="@style/CalculatorButton.Dark"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_8"
            style="@style/CalculatorButton.Dark"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_9"
            style="@style/CalculatorButton.Dark"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_minus"
            style="@style/CalculatorButton.Light"
            android:text="-" />

        <!-- Row 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_4"
            style="@style/CalculatorButton.Dark"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_5"
            style="@style/CalculatorButton.Dark"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_6"
            style="@style/CalculatorButton.Dark"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plus"
            style="@style/CalculatorButton.Light"
            android:text="+" />

        <!-- Row 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_1"
            style="@style/CalculatorButton.Dark"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_2"
            style="@style/CalculatorButton.Dark"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_3"
            style="@style/CalculatorButton.Dark"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_equals"
            style="@style/CalculatorButton.Accent"
            android:text="=" />

        <!-- Row 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plus_minus"
            style="@style/CalculatorButton.Dark"
            android:text="+/-" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_0"
            style="@style/CalculatorButton.Dark"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dot"
            style="@style/CalculatorButton.Dark"
            android:text="." />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
